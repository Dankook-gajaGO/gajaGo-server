# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 깃에 올리지 않음)

# 1. Google Gemini API 키 (Google AI Studio)
GEMINI_API_KEY=
# (선택) 모델이 종료되면 바꾸기. 기본값 gemini-2.5-flash
# GEMINI_MODEL=gemini-flash-latest
# 2. SK TMAP API 키 (SK open API)
TMAP_KEY=
# 3. 한국관광공사 TourAPI 키 (data.go.kr, 축제 수집용)
TOUR_API_KEY=

# 4. MySQL (docker-compose가 같은 값으로 DB를 만들어 줌)
DB_NAME=gajago_db
DB_USER=gajago
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 5. JWT 서명 키 (Base64, 32바이트 이상). 생성: openssl rand -base64 48
JWT_SECRET=
